{
  "name": "permits-cloudflare-backend",
  "version": "1.0.0",
  "description": "Building Permits App Backend on Cloudflare Workers + D1 + R2",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute permits-db --file=./schema.sql",
    "d1:init:local": "wrangler d1 execute permits-db --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}

